# ─────────────────────────────────────────────
# CodePlans — Environment Configuration
# Copy this file to .env.local and fill in the
# values for your chosen setup.
# ─────────────────────────────────────────────


# ── Host mode ─────────────────────────────────
# saas: multi-tenant hosted instance, open registration, billing available.
# team: single private team, registration closed by default, billing hidden.
HOST_MODE=team

# ── Registration ──────────────────────────────
# open:   anyone can sign up at /signup.
# invite: /signup shows an invite-only message (token flow coming soon).
# closed: /signup returns 404; users created by admin via pnpm db:seed.
REGISTRATION=closed

# ── Auth & DB providers ───────────────────────
# Both are worked out when unset: local auth unless Supabase is configured,
# and the database follows DATABASE_URL (postgres:// -> Postgres, otherwise
# SQLite). Set them only to override.
AUTH_PROVIDER=local
DB_PROVIDER=sqlite


# ── Database ──────────────────────────────────
# SQLite: file: path (default file:$DATA_DIR/codeplans.db), ":memory:", or a
#         hosted libsql:// URL (Turso; set DATABASE_AUTH_TOKEN).
# Postgres: full connection string.
DATABASE_URL=file:data/codeplans.db
# DATABASE_URL=postgresql://user:password@localhost:5432/codeplans
# DATA_DIR=data          # where the default SQLite file lives (/data in Docker)
# DB_SSL=false           # force Postgres TLS off/on; by default it's off for
#                        # private hosts (localhost, *.internal, *.flycast) and on otherwise
# MIGRATE_ON_BOOT=true   # apply migrations at server start (on in production)
# ALLOW_EPHEMERAL_DB=true  # let SQLite run on Railway/Fly/Render without a volume
#                          # (otherwise it refuses: every deploy would wipe the data)


# ── Local auth ────────────────────────────────
# Required when AUTH_PROVIDER=local.
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# Public URL of the server. Detected on Railway, Fly.io and Render; set it
# for custom domains and other hosts. Not needed for local dev on localhost.
# AUTH_URL=https://codeplans.yourteam.com
# AUTH_URL=http://YOUR_SERVER_IP:3000

# First owner account. Without these, a fresh instance shows /setup and logs a
# one-time setup code. Ignored once any account exists.
# ADMIN_EMAIL=you@yourteam.com
# ADMIN_PASSWORD=at-least-8-characters
# ADMIN_NAME=Your Name


# ── Server ───────────────────────────────────
# Port for the dev server (default: 3000)
PORT=3000

# ── Remote dev server (optional) ─────────────
# When running `pnpm dev` on a remote host and accessing it from a browser
# on a different IP, add the server's IP or hostname here (comma-separated).
# ALLOWED_DEV_ORIGINS=165.22.120.48

# ── Feature flags ─────────────────────────────
# Set to "false" to hide all billing UI (default for OSS / local mode).
BILLING_ENABLED=false

# ── Enterprise module (optional, closed-source) ──
# Set to "true" only if you have installed the private "@codeplans/enterprise"
# package. Has no effect otherwise — the community edition never requires it.
# See docs/guides/enterprise-extensions.md.
# ENTERPRISE_ENABLED=true


# ── Resend (transactional email) ──────────────
# Required for email verification (email change, future: team invites).
# Get an API key at https://resend.com → API Keys.
# Without this, verification URLs are printed to the server console (dev only).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=CodePlans <noreply@yourdomain.com>
# Notification email and Slack can instead be set up by an admin in
# Settings → Manage workspace notifications. See docs/guides/notifications.md.
# RESEND_API_URL=https://api.resend.com
# NOTIFY_WEBHOOK_ALLOWED_HOSTS=chat.internal.example.com
# Enables /api/cron/notifications (email/Slack retries) for an external cron.
# CRON_SECRET=a-long-random-string
# Team mode retries in-process instead; 0 turns that off.
# NOTIFY_INTERVAL_SECONDS=60


# ── Supabase (cloud mode only) ────────────────
# Required when AUTH_PROVIDER=supabase or DB_PROVIDER=postgres via Supabase.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# SUPABASE_SECRET_KEY=your-service-role-key


# ── AI drafting (optional) ────────────────────
# Enables "Draft release notes" and "Draft design note from plan".
# All AI features are hidden without a key — the app never requires one.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# AI_ENABLED=true
# AI_MODEL=claude-opus-5

# ── Public GitHub import (optional) ───────────
# Raises GitHub's anonymous rate limit for the read-only import_github_issues
# MCP tool. Any personal token works; no scopes are needed.
# GITHUB_PUBLIC_TOKEN=github_pat_xxxxxxxx
