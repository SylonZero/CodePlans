{
  "name": "codeplans",
  "version": "0.7.11",
  "description": "Manage and track coordinated changes across your software architecture.",
  "author": "Sai Prakash <sylonzero@gmail.com>",
  "homepage": "https://codeplans.ai",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env.local --import=tsx lib/db/seed.ts",
    "db:seed-demo": "node --env-file=.env.local --import=tsx lib/db/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cli:build": "npm run build --prefix cli",
    "cli:pack": "npm run build --prefix cli && cd cli && npm pack --dry-run",
    "specs:migrate": "node --env-file=.env.local --import=tsx scripts/migrate-specs.ts"
  },
